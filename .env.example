# ---------------------------------------------------------------------------
# EduVault frontend configuration
#
# Copy this file to .env.local and adjust as needed. Real .env* files are
# gitignored; this example is committed and must never contain secrets.
# ---------------------------------------------------------------------------

# Base URL of the EduVault backend.
#
# Server-only on purpose. Every backend call is made from a server component or
# a route handler, so the browser never needs this address and the bearer token
# never leaves the server. Do NOT rename this to NEXT_PUBLIC_*.
EDUVAULT_API_URL=https://eduvault-jadl.onrender.com

# ---------------------------------------------------------------------------
# Playwright end-to-end tests only. Leave unset to skip the authenticated specs.
# Point these at a staging account - never at real student data.
# ---------------------------------------------------------------------------
# E2E_BASE_URL=http://localhost:3000
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
# E2E_TEACHER_EMAIL=
# E2E_TEACHER_PASSWORD=
